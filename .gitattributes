# Autodetect text files; normalize to LF in the repository
* text=auto

# Sources checked by dotnet format (.editorconfig: end_of_line = crlf)
*.cs      text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.sln     text eol=crlf
*.json    text eol=crlf
*.md      text eol=crlf
.editorconfig text eol=crlf

# Files that must stay LF (they run on Linux)
*.sh      text eol=lf
Dockerfile text eol=lf